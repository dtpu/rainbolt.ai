# Root env for docker-compose. Copy to `.env` and fill in.
# Backend keys live in backend/.env (see backend/.env.example).

# Where the browser reaches the backend (baked into the frontend bundle at build)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000

# Supabase (public, client-side): auth + session persistence.
# Project settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for the server-to-server upload proxy. The Next.js /api/upload
# route sends this to the backend's /upload-image. Must match the value in
# backend/.env (BACKEND_INTERNAL_KEY).
BACKEND_INTERNAL_KEY=

